{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@rgs-ledger/shared-types": ["packages/shared-types/src/index.ts"],
      "@rgs-ledger/shared-types/*": ["packages/shared-types/src/*"],
      "@rgs-ledger/api-contracts": ["packages/api-contracts/src/index.ts"],
      "@rgs-ledger/api-contracts/*": ["packages/api-contracts/src/*"],
      "@rgs-ledger/validation": ["packages/validation/src/index.ts"],
      "@rgs-ledger/validation/*": ["packages/validation/src/*"],
      "@rgs-ledger/ui": ["packages/ui/src/index.tsx"],
      "@rgs-ledger/ui/*": ["packages/ui/src/*"],
      "@rgs-ledger/upi-adapter": ["packages/upi-adapter/src/index.ts"],
      "@rgs-ledger/upi-adapter/*": ["packages/upi-adapter/src/*"]
    }
  }
}
