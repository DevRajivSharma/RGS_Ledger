# ==============================================================================
# RGS LEDGER API - ENVIRONMENT CONFIGURATION
# Location: apps/api/.env
# ==============================================================================

# Application Environment
NODE_ENV=development
PAYMENT_ENVIRONMENT=SANDBOX
LOG_LEVEL=info

# Network & Server Binding
API_PORT=4000
API_URL=http://localhost:4000

# Client Application URLs (used for CORS and redirect resolution)
DASHBOARD_URL=http://localhost:5173
CHECKOUT_URL=http://localhost:5174
DEVELOPER_PORTAL_URL=http://localhost:5175
ADMIN_URL=http://localhost:5176

# Database & Cache
# Local MongoDB connection (Required)
MONGODB_URI=mongodb://localhost:27017/rgs_ledger

# Redis URL for BullMQ Webhook Delivery & Job Queues
# (Optional for local dev: If offline, API automatically falls back to in-memory queue)
REDIS_URL=redis://localhost:6379

# Cryptography & Security Secrets
# In production, generate 64 hex character random strings: openssl rand -hex 32
JWT_ACCESS_SECRET=rgs_dev_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=rgs_dev_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECRET=rgs_dev_cookie_secret_change_in_production_min_32_chars
WEBHOOK_SIGNING_SECRET=whsec_dev_signing_secret_change_in_production

# Storage Provider (local | s3 | gcs)
STORAGE_PROVIDER=local
STORAGE_BUCKET=rgs-ledger-documents
LOCAL_UPLOAD_DIR=./uploads

# Default minor currency units (paise: 1 INR = 100 paise)
DEFAULT_CURRENCY=INR

# Email / Notification Provider (SMTP or simulated)
# Optional in development: if SMTP is offline, email notifications are logged
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@rgsledger.com
NOTIFICATIONS_ENABLED=true

# External Payment Provider Adapter (Simulated in Sandbox)
PROVIDER_BASE_URL=https://api.partner-bank.example.com
PROVIDER_PUBLIC_KEY=pub_test_mock_gateway_key
PROVIDER_SECRET_KEY=sec_test_mock_gateway_secret
