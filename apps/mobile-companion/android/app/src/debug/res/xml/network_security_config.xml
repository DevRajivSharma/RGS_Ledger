<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Explicit domain configuration for local development and LAN IP testing -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.1.6</domain>
    </domain-config>

    <!-- Debug base configuration allowing cleartext HTTP for any local development network -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
