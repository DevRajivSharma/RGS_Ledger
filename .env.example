# ==============================================================================
# RGS LEDGER - ENTERPRISE FINTECH PAYMENT PLATFORM CONFIGURATION
# Production & Sandbox Environment Variable Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=development
# Global default payment processing mode (SANDBOX | LIVE)
PAYMENT_ENVIRONMENT=SANDBOX
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. SERVICE URLS & NETWORKING
# ------------------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
PUBLIC_API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
CHECKOUT_URL=http://localhost:5174
DEVELOPER_PORTAL_URL=http://localhost:5175
ADMIN_URL=http://localhost:5176

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENT REDIS QUEUE
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/rgs_ledger
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHY, JWT & MASTER CREDENTIAL ENCRYPTION
# ------------------------------------------------------------------------------
# CRITICAL: In production, generate 64 hex characters (32 bytes) cryptographically.
# The master ENCRYPTION_KEY encrypts all merchant provider credentials at rest via AES-256-GCM.
# Example generator: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_secure_random_secret
JWT_REFRESH_SECRET=replace_with_secure_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=replace_with_64_hex_character_key
COOKIE_SECRET=replace_with_secure_random_secret
WEBHOOK_SIGNING_SECRET=replace_with_secure_random_secret

# ------------------------------------------------------------------------------
# 5. PLATFORM DEFAULT PROVIDER CREDENTIALS (UPIPAY / PHONEPE / PAYTM)
# Note: For multi-tenant isolation, individual merchants configure their own
# encrypted credentials via the Merchant Dashboard or /api/v1/merchant/providers.
# The values below serve as platform-level fallbacks for platform sandbox testing.
# In production, leave empty or configure real live credentials via vault.
# ------------------------------------------------------------------------------

# PhonePe Business (Obtain from business.phonepe.com -> Developer Settings)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_ENV=sandbox
PHONEPE_CALLBACK_URL=http://localhost:4000/api/v1/callbacks/phonepe
PHONEPE_REDIRECT_URL=http://localhost:5174/checkout

# Paytm Business (Obtain from business.paytm.com -> Developer Settings)
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=
PAYTM_ENV=sandbox
PAYTM_CALLBACK_URL=http://localhost:4000/api/v1/callbacks/paytm
PAYTM_REDIRECT_URL=http://localhost:5174/checkout

# Default Raw UPI QR Payee (Merchant-specific VPAs take precedence in production)
DEFAULT_MERCHANT_VPA=
DEFAULT_MERCHANT_NAME=
DEFAULT_MERCHANT_MCC=

# ------------------------------------------------------------------------------
# 6. CARD & NETBANKING PROVIDER ADAPTERS (REQUIRES AUTHORIZED MERCHANT ACQUIRING)
# Card and Netbanking CANNOT be processed via UPIPay (UPI-only).
# Leave blank or unconfigured until an authorized acquiring agreement is executed.
# ------------------------------------------------------------------------------
CARD_GATEWAY_NAME=
CARD_GATEWAY_KEY=
CARD_GATEWAY_SECRET=
NETBANKING_GATEWAY_KEY=
NETBANKING_GATEWAY_SECRET=

# ------------------------------------------------------------------------------
# 7. NOTIFICATION & FILE STORAGE
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=INR
STORAGE_PROVIDER=local
STORAGE_BUCKET=rgs-ledger-documents
LOCAL_UPLOAD_DIR=./uploads

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@rgsledger.com
NOTIFICATIONS_ENABLED=true
