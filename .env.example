# ==============================================================================
# RGS LEDGER — ENVIRONMENT VARIABLE TEMPLATE (.env.example)
# DO NOT STORE REAL SECRETS IN THIS FILE.
# Copy this file to .env and replace placeholders with production/local values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER & RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Merchant Dashboard URL (defaults to http://localhost:3001)
# Used for merchant portal redirects and tenant console access.
# NOTE: In production mode (NODE_ENV=production), localhost and 127.0.0.1 are strictly rejected.
MERCHANT_DASHBOARD_URL=http://localhost:3001

# Customer-Facing Hosted Checkout URL (defaults to http://localhost:3002)
# Used for generating public UPI payment links (?link=... and ?plink=...).
# NOTE: In production mode (NODE_ENV=production), localhost and 127.0.0.1 are strictly rejected.
HOSTED_CHECKOUT_URL=http://localhost:3002

# Frontend URL alias (synchronized automatically with MERCHANT_DASHBOARD_URL if either is omitted)
FRONTEND_URL=http://localhost:3001

# Comma-separated list of allowed CORS origins for browser web applications.
# Accepts wildcard '*' or explicit domain origins.
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Alias note: For backward compatibility, CORS_ORIGIN is accepted as an alias for ALLOWED_CORS_ORIGINS if ALLOWED_CORS_ORIGINS is unset.
# CORS_ORIGIN=http://localhost:3001

# ------------------------------------------------------------------------------
# 2. DATABASE (MONGODB ATLAS OR LOCAL REPLICA SET)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Replica set required in production for multi-document ACID transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rgs_ledger?retryWrites=true&w=majority

# MongoDB connection pool sizing
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT Access Secret: Signs merchant and admin access tokens (min 16 chars, recommend 32+ high entropy)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_here

# Alias note: For backward compatibility, JWT_SECRET is accepted as an alias for JWT_ACCESS_SECRET if JWT_ACCESS_SECRET is unset.
# JWT_SECRET=your_super_secret_jwt_access_key_min_32_characters_here

# JWT Refresh Secret: Independently HMAC-hashes refresh tokens for secure rotation and revocation (min 16 chars)
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_here

# Token Lifespans (Zeit/ms format, e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Express session signing secret (min 16 chars, recommend 32+)
SESSION_SECRET=session_secret_signing_key_replace_in_production_min_32_chars

# AES-256-GCM Data-at-rest encryption key for sensitive credentials (Gmail OAuth tokens, private API keys)
# Must be exactly 64 hexadecimal characters representing a 32-byte binary key.
ENCRYPTION_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. RATE LIMITING
# ------------------------------------------------------------------------------
# Sliding window duration in milliseconds for IP and authentication rate limiters (default: 60,000 ms = 1 min)
RATE_LIMIT_WINDOW_MS=60000

# Maximum permitted requests per window per IP/tenant (default: 120 requests/min)
RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# 5. EVIDENCE TIMEOUTS & THRESHOLDS (MILLISECONDS)
# ------------------------------------------------------------------------------
# Payment request expiry duration (default: 15 minutes = 900,000 ms)
# Unmatched payments transition from PENDING to EXPIRED after this window.
PAYMENT_EXPIRY_MS=900000

# Window to accept late evidence for reconciliation (default: 24 hours = 86,400,000 ms)
EVIDENCE_RECONCILIATION_WINDOW_MS=86400000

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE WORKER DISPATCHER & ADMIN BOOTSTRAP SECRETS
# ------------------------------------------------------------------------------
# Shared secret for scheduled cron trigger (sent in 'x-scheduler-secret' header by Cloudflare Worker scheduler)
# Cloudflare Worker dispatches POST requests to /api/v1/background-jobs/dispatch every minute.
SCHEDULER_SHARED_SECRET=replace_with_a_high_entropy_random_hex_string_for_cron

# Initial System Administrator bootstrap secret (min 16 chars).
# Required by POST /api/v1/admin/auth/bootstrap to create the first admin account.
# NOTE: In production (NODE_ENV=production), this variable MUST be explicitly set and cannot use the development fallback.
ADMIN_BOOTSTRAP_SECRET=replace_with_a_secure_admin_bootstrap_secret_min_16_chars

# ------------------------------------------------------------------------------
# 7. STRUCTURED LOGGING
# ------------------------------------------------------------------------------
# Log level: 'debug' | 'info' | 'warn' | 'error' (default: info)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH & GMAIL INTEGRATION
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Client credentials for bank email synchronization
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Must match the mounted route and Authorized Redirect URI in Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/v1/integrations/gmail/callback
